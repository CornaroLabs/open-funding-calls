{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CornaroLabs/open-funding-calls/schema/funding-call.schema.json",
  "title": "Open Funding Calls: funding call record",
  "description": "One open, upcoming or closed funding opportunity (a grant call, round or programme window). Version 0.1.0 (prototype).",
  "type": "object",
  "required": ["specVersion", "id", "title", "funder", "status", "sourceUrl", "provenance"],
  "additionalProperties": false,
  "properties": {
    "specVersion": { "const": "0.1.0" },
    "id": {
      "type": "string",
      "description": "Publisher-assigned identifier, stable across updates. Recommended form: <publisher-prefix>:<local-id>.",
      "pattern": "^[a-z0-9][a-z0-9.-]*:[A-Za-z0-9._~/-]+$"
    },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "funder": { "$ref": "#/$defs/organization" },
    "programme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "status": {
      "description": "Lifecycle status of the call.",
      "enum": ["upcoming", "open", "rolling", "paused", "closed", "cancelled"]
    },
    "fundingType": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["grant", "prize", "bounty", "retroactive", "quadratic-funding", "milestone-grant", "equity-free-investment", "loan", "in-kind", "fellowship", "other"]
      }
    },
    "topics": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "ecosystems": {
      "description": "Technology ecosystems the call targets, e.g. ethereum, arbitrum, cardano.",
      "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "description": "Funding amounts in the unit the funder uses. No conversion is implied.",
      "required": ["currency"],
      "properties": {
        "currency": {
          "type": "string",
          "description": "ISO 4217 code for fiat (EUR, USD) or a crypto asset ticker prefixed with 'crypto:' (crypto:ARB, crypto:ETH).",
          "pattern": "^([A-Z]{3}|crypto:[A-Za-z0-9]{2,12})$"
        },
        "minPerProject": { "type": "number", "minimum": 0 },
        "maxPerProject": { "type": "number", "minimum": 0 },
        "totalBudget": { "type": "number", "minimum": 0 },
        "fundingRatePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opens": { "type": "string", "format": "date-time" },
        "deadlines": {
          "description": "One or more cut-off dates. ISO 8601 with a time zone offset.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dateTime"],
            "properties": {
              "dateTime": { "type": "string", "format": "date-time" },
              "label": { "type": "string" }
            }
          }
        },
        "rolling": { "type": "boolean", "description": "True when applications are reviewed continuously with no fixed deadline." }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicantTypes": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["individual", "collective", "non-profit", "foundation", "university", "research-institute", "public-body", "sme", "startup", "large-company", "dao", "any"] }
        },
        "countries": {
          "description": "ISO 3166-1 alpha-2 codes, or group codes such as 'EU', 'HE-ASSOCIATED' (Horizon Europe eligible), 'WORLD'.",
          "type": "array", "items": { "type": "string", "pattern": "^([A-Z]{2}|EU|EEA|HE-ASSOCIATED|WORLD)$" }, "uniqueItems": true
        },
        "openSourceRequired": { "type": "boolean" },
        "text": { "$ref": "#/$defs/text", "description": "Authoritative eligibility text, summarised or quoted from the source." }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "process": { "$ref": "#/$defs/text" }
      }
    },
    "sourceUrl": { "type": "string", "format": "uri", "description": "Canonical page where the funder publishes the call." },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "lastVerified"],
      "properties": {
        "publisher": { "type": "string", "description": "Who produced this record, e.g. web3grants.co." },
        "retrieved": { "type": "string", "format": "date-time" },
        "lastVerified": { "type": "string", "format": "date-time", "description": "When a human or process last checked the record against the source." },
        "license": { "type": "string", "description": "SPDX identifier of the data licence, e.g. CC-BY-4.0." }
      }
    }
  },
  "$defs": {
    "text": {
      "description": "Plain string, or an object of language-tagged strings (BCP 47).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object", "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri" },
        "identifiers": {
          "description": "Stable identifiers: ROR (https://ror.org/...), Wikidata (Q...), or chain addresses (eip155:<chainId>:<address>).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "value"],
            "properties": {
              "scheme": { "enum": ["ror", "wikidata", "caip10", "other"] },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
